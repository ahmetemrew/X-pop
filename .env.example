# ============================================
# Twitter API Mode (mode: "api" in config.yaml)
# ============================================
# Twitter API Keys (https://developer.twitter.com/en/portal/dashboard)
# Sadece API mode için gerekli
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here
TWITTER_BEARER_TOKEN=your_bearer_token_here

# ============================================
# Selenium Mode (mode: "selenium" in config.yaml)
# ============================================
# Twitter Login Credentials
# Sadece Selenium mode için gerekli - API anahtarı gerekmez!
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_twitter_email  # Email verification için (opsiyonel)

# Selenium Settings
SELENIUM_HEADLESS=true  # true = görünmez tarayıcı, false = görünür

# ============================================
# AI Settings (Her iki mode için gerekli)
# ============================================
# Groq AI API (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Bot Settings
CHECK_INTERVAL_MINUTES=5
MAX_TWEETS_PER_RUN=5
