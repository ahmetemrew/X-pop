#!/bin/bash

# X-Pop Bot - Ana Kontrol Komutu
# Kullanım: twitter

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

# Banner
show_banner() {
    clear
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║                                                       ║${NC}"
    echo -e "${CYAN}║              🤖  X-POP BOT KONTROL  🤖               ║${NC}"
    echo -e "${CYAN}║                                                       ║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════╝${NC}"
    echo ""
}

# Bot dizinini bul
find_bot_dir() {
    # Birkaç yaygın lokasyonu kontrol et
    for dir in \
        "$HOME/X-pop" \
        "/opt/X-pop" \
        "/home/*/X-pop" \
        "$(pwd)"; do
        if [ -f "$dir/config/config.yaml" ]; then
            echo "$dir"
            return 0
        fi
    done
    return 1
}

BOT_DIR=$(find_bot_dir)

if [ -z "$BOT_DIR" ]; then
    echo -e "${RED}❌ X-Pop Bot bulunamadı!${NC}"
    echo -e "${YELLOW}Lütfen bot dizininde çalıştırın veya kurulumu yapın.${NC}\n"
    exit 1
fi

cd "$BOT_DIR"

# Ana menü
show_menu() {
    show_banner

    # Servis durumu
    if systemctl is-active --quiet xpop-bot 2>/dev/null; then
        echo -e "${GREEN}🟢 Bot Durumu: ÇALIŞIYOR${NC}"

        # PID ve resource
        PID=$(systemctl show -p MainPID --value xpop-bot 2>/dev/null)
        if [ ! -z "$PID" ] && [ "$PID" != "0" ]; then
            CPU=$(ps -p $PID -o %cpu= 2>/dev/null | tr -d ' ')
            MEM=$(ps -p $PID -o %mem= 2>/dev/null | tr -d ' ')
            echo -e "${BLUE}📊 CPU: ${YELLOW}${CPU}%${NC}, RAM: ${YELLOW}${MEM}%${NC}"
        fi
    else
        echo -e "${RED}🔴 Bot Durumu: DURMUŞ${NC}"
    fi

    echo ""
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""

    # İstatistikler
    if [ -f "data/bot.db" ]; then
        TOTAL_POSTED=$(sqlite3 data/bot.db "SELECT COUNT(*) FROM generated_tweets;" 2>/dev/null || echo "0")
        TODAY=$(date +%Y-%m-%d)
        TODAY_POSTS=$(sqlite3 data/bot.db "SELECT COUNT(*) FROM generated_tweets WHERE DATE(created_at) = '$TODAY';" 2>/dev/null || echo "0")

        echo -e "${MAGENTA}📊 Hızlı İstatistikler:${NC}"
        echo -e "  ${GREEN}📤 Toplam Paylaşılan:${NC} ${YELLOW}${TOTAL_POSTED}${NC}"
        echo -e "  ${GREEN}📅 Bugün Paylaşılan:${NC} ${YELLOW}${TODAY_POSTS}${NC}"
        echo ""
    elif [ -f "data/tweets.db" ]; then
        TOTAL_POSTED=$(sqlite3 data/tweets.db "SELECT COUNT(*) FROM posted_tweets;" 2>/dev/null || echo "0")
        TODAY=$(date +%Y-%m-%d)
        TODAY_POSTS=$(sqlite3 data/tweets.db "SELECT COUNT(*) FROM posted_tweets WHERE DATE(posted_at) = '$TODAY';" 2>/dev/null || echo "0")

        echo -e "${MAGENTA}📊 Hızlı İstatistikler:${NC}"
        echo -e "  ${GREEN}📤 Toplam Paylaşılan:${NC} ${YELLOW}${TOTAL_POSTED}${NC}"
        echo -e "  ${GREEN}📅 Bugün Paylaşılan:${NC} ${YELLOW}${TODAY_POSTS}${NC}"
        echo ""
    fi

    # Menü seçenekleri
    echo -e "${BLUE}🎮 Seçenekler:${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "  ${GREEN}1${NC}) 📊 Detaylı İstatistikler"
    echo -e "  ${GREEN}2${NC}) 📺 Canlı Log İzle"
    echo -e "  ${GREEN}3${NC}) 🔄 Bot'u Yeniden Başlat"
    echo -e "  ${GREEN}4${NC}) ⏸️  Bot'u Durdur"
    echo -e "  ${GREEN}5${NC}) ▶️  Bot'u Başlat"
    echo -e "  ${GREEN}6${NC}) ⚙️  Konfigürasyon Göster"
    echo -e "  ${GREEN}7${NC}) ✏️  Ayarları Düzenle"
    echo -e "  ${GREEN}8${NC}) 📝 Son Log Satırları"
    echo -e "  ${GREEN}0${NC}) 🚪 Çıkış"
    echo ""
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""

    read -p "$(echo -e "${YELLOW}Seçiminiz [0-8]: ${NC}")" choice

    case $choice in
        1) show_stats ;;
        2) live_logs ;;
        3) restart_bot ;;
        4) stop_bot ;;
        5) start_bot ;;
        6) show_config ;;
        7) edit_settings ;;
        8) show_logs ;;
        0) exit 0 ;;
        *)
            echo -e "${RED}Geçersiz seçim!${NC}"
            sleep 1
            show_menu
            ;;
    esac
}

# İstatistikler
show_stats() {
    clear
    ./stats.sh
    echo ""
    read -p "$(echo -e "${YELLOW}Enter ile geri dön...${NC}")"
    show_menu
}

# Canlı log
live_logs() {
    clear
    echo -e "${CYAN}📺 Canlı Log İzleme (Ctrl+C ile çık)${NC}\n"

    if systemctl is-active --quiet xpop-bot 2>/dev/null; then
        sudo journalctl -u xpop-bot -f --no-pager
    else
        echo -e "${RED}Bot çalışmıyor!${NC}"
        sleep 2
    fi

    show_menu
}

# Restart
restart_bot() {
    echo ""
    echo -e "${YELLOW}🔄 Bot yeniden başlatılıyor...${NC}"

    if command -v systemctl &> /dev/null && systemctl list-unit-files | grep -q xpop-bot; then
        sudo systemctl restart xpop-bot
        sleep 2
        if systemctl is-active --quiet xpop-bot; then
            echo -e "${GREEN}✅ Bot yeniden başlatıldı!${NC}"
        else
            echo -e "${RED}❌ Bot başlatılamadı!${NC}"
        fi
    else
        echo -e "${RED}Systemd servisi bulunamadı!${NC}"
    fi

    sleep 2
    show_menu
}

# Stop
stop_bot() {
    echo ""
    read -p "$(echo -e "${YELLOW}⚠️  Bot'u durdurmak istediğinizden emin misiniz? [e/H]: ${NC}")" confirm

    if [[ $confirm =~ ^[Ee]$ ]]; then
        echo -e "${YELLOW}⏸️  Bot durduruluyor...${NC}"

        if command -v systemctl &> /dev/null && systemctl list-unit-files | grep -q xpop-bot; then
            sudo systemctl stop xpop-bot
            echo -e "${GREEN}✅ Bot durduruldu!${NC}"
        else
            echo -e "${RED}Systemd servisi bulunamadı!${NC}"
        fi
    else
        echo -e "${BLUE}İptal edildi.${NC}"
    fi

    sleep 2
    show_menu
}

# Start
start_bot() {
    echo ""
    echo -e "${YELLOW}▶️  Bot başlatılıyor...${NC}"

    if command -v systemctl &> /dev/null && systemctl list-unit-files | grep -q xpop-bot; then
        sudo systemctl start xpop-bot
        sleep 2
        if systemctl is-active --quiet xpop-bot; then
            echo -e "${GREEN}✅ Bot başlatıldı!${NC}"
        else
            echo -e "${RED}❌ Bot başlatılamadı!${NC}"
            echo -e "${YELLOW}Log'ları kontrol edin: sudo journalctl -u xpop-bot -n 50${NC}"
        fi
    else
        echo -e "${RED}Systemd servisi bulunamadı!${NC}"
        echo -e "${YELLOW}Servisi kurmak için: sudo ./service-install.sh${NC}"
    fi

    sleep 2
    show_menu
}

# Config göster
show_config() {
    clear
    echo -e "${CYAN}⚙️  Mevcut Konfigürasyon:${NC}\n"

    if [ -f "config/config.yaml" ]; then
        # Ana ayarları göster
        echo -e "${BLUE}Mod:${NC} $(grep "^mode:" config/config.yaml | awk '{print $2}' | tr -d '"')"
        echo -e "${BLUE}Kişilik:${NC} $(grep "personality:" config/config.yaml | head -1 | awk '{print $2}' | tr -d '"')"
        echo -e "${BLUE}Interval:${NC} $(grep "check_interval:" config/config.yaml | head -1 | awk '{print $2}') dakika"
        echo -e "${BLUE}Resim:${NC} $(grep "enabled:" config/config.yaml | head -1 | awk '{print $2}')"

        echo ""
        echo -e "${YELLOW}İzlenen Hesaplar:${NC}"
        grep -A 10 "monitored_accounts:" config/config.yaml | grep '  - ' | sed 's/  - /  • /'
    else
        echo -e "${RED}Config dosyası bulunamadı!${NC}"
    fi

    echo ""
    read -p "$(echo -e "${YELLOW}Enter ile geri dön...${NC}")"
    show_menu
}

# Ayarları düzenle
edit_settings() {
    if [ -f "./edit-settings.sh" ]; then
        bash ./edit-settings.sh
    else
        echo -e "${RED}edit-settings.sh bulunamadı!${NC}"
        sleep 2
    fi
    show_menu
}

# Son loglar
show_logs() {
    clear
    echo -e "${CYAN}📝 Son 20 Log Satırı:${NC}\n"

    if systemctl is-active --quiet xpop-bot 2>/dev/null; then
        sudo journalctl -u xpop-bot -n 20 --no-pager
    elif [ -f "logs/bot.log" ]; then
        tail -20 logs/bot.log
    else
        echo -e "${RED}Log bulunamadı!${NC}"
    fi

    echo ""
    read -p "$(echo -e "${YELLOW}Enter ile geri dön...${NC}")"
    show_menu
}

# Ana program
show_menu
