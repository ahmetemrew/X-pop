[Unit]
Description=X-Pop Twitter Bot - BULLETPROOF MODE
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%USER%
WorkingDirectory=%WORKDIR%
Environment="PATH=%WORKDIR%/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"

# Execute bot
ExecStart=%WORKDIR%/venv/bin/python3 -m src.main --interval 10

# Restart policy - AGGRESSIVE (always restart, no limits)
Restart=always
RestartSec=10s
StartLimitInterval=0
StartLimitBurst=0

# Resource limits
MemoryLimit=1G
CPUQuota=200%

# Logging
StandardOutput=append:/var/log/xpop-bot/stdout.log
StandardError=append:/var/log/xpop-bot/stderr.log
SyslogIdentifier=xpop-bot

# Security (optional - uncomment if needed)
# NoNewPrivileges=true
# PrivateTmp=true

[Install]
WantedBy=multi-user.target
